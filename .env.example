# sshby ortam değişkenleri.
# Bu dosyayı .env olarak kopyalayın ve değerleri kendi ortamınıza göre doldurun.
# .env asla depoya girmemeli (.gitignore'da).

# ------------------------------------------------------------------- çalışma
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000

# Tarayıcının uygulamaya eriştiği kök adres. Cookie'nin "secure" bayrağı ve
# geliştirme CORS'u buna bakar.
PUBLIC_ORIGIN=http://localhost:8080

# ------------------------------------------------------------- veritabanı
DATABASE_URL=postgres://sshby:sshby@localhost:5432/sshby
DATABASE_POOL_MAX=10

# --------------------------------------------------------------- gizli anahtarlar
#
# SSHBY_MASTER_KEY kasadaki tüm kredensiyelleri koruyan kök anahtardır.
# KAYBEDİLİRSE kayıtlı hiçbir parola veya SSH anahtarı geri getirilemez.
# Yedeğini parola yöneticisinde/kasada saklayın.
#
# Üretim için yeni anahtar üretin:
#   openssl rand -base64 32
#
# Aşağıdaki değer bilinen bir geliştirme anahtarıdır — üretimde kullanmayın.
SSHBY_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcyEhISE=
SSHBY_MASTER_KEY_VERSION=1
# Rotasyon sırasında eski anahtarlarla yazılmış kayıtlar için:
#   SSHBY_MASTER_KEY_PREVIOUS=1:<eski-base64-anahtar>
# SSHBY_MASTER_KEY_PREVIOUS=

# En az 32 karakter. Üretim için: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-en-az-32-karakter-uzunlugunda
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# auto = PUBLIC_ORIGIN https ise güvenli cookie kullan
COOKIE_SECURE=auto

# Vite dev sunucusu ayrı portta çalışırken gerekir (üretimde boş bırakın).
# DEV_CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------- ssh
SSH_CONNECT_TIMEOUT_MS=15000
SSH_KEEPALIVE_INTERVAL_MS=20000
SSH_MAX_SESSIONS_PER_USER=20

# --------------------------------------------------------------------- denetim
AUDIT_FLUSH_INTERVAL_MS=2000
AUDIT_BULK_SIZE=500
# true iken: denetim Elasticsearch'e yazılamıyorsa yeni SSH oturumu açılmasına
# izin verilmez ("kayıt tutulamıyorsa bağlanma" politikası).
AUDIT_STRICT_MODE=false
