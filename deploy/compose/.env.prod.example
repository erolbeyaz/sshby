# sshby — üretim ortam değişkenleri.
#
#   cp .env.prod.example .env
#
# `.env` bu dizinde durur ve depoya girmez (.gitignore). Aşağıda varsayılanı
# olmayan değerler zorunludur: verilmezlerse compose başlamaz. Bu bilinçli —
# geliştirme anahtarlarıyla üretime çıkmak sessizce mümkün olmamalı.

# =============================================================== ZORUNLU

# Kasadaki tüm parolaları ve SSH anahtarlarını koruyan kök anahtar.
# KAYBEDİLİRSE kayıtlı hiçbir gizli veri geri getirilemez — veritabanı
# yedeğiniz olsa bile. Parola yöneticinizde saklayın.
#
#   openssl rand -base64 32
SSHBY_MASTER_KEY=

# Oturum jetonlarını imzalar. Değiştirilirse açık tüm oturumlar düşer
# (kullanıcılar yeniden giriş yapar); veri kaybı olmaz.
#
#   openssl rand -hex 32
JWT_SECRET=

# Veritabanı parolası.
#
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Tarayıcının uygulamaya eriştiği kök adres.
# TLS sonlandıran bir ters proxy varsa onun https adresini yazın: oturum
# çerezinin `secure` bayrağı buna bakıyor ve yanlış değer oturumu bozar.
PUBLIC_ORIGIN=https://sshby.sirket.local

# =============================================================== İSTEĞE BAĞLI

# Dinlenecek adres ve port. Varsayılan yalnızca localhost'tan erişilebilir.
# Dışarı açmak için 0.0.0.0 yapın — ama TLS sonlandıran bir ters proxy
# arkasında. sshby oturum çerezleri ve SSH parolaları taşıyor.
# SSHBY_BIND_ADDRESS=127.0.0.1
# SSHBY_WEB_PORT=8088

# Veritabanı kullanıcı ve şema adı (varsayılan: sshby).
# POSTGRES_USER=sshby
# POSTGRES_DB=sshby
# DATABASE_POOL_MAX=10

# Kök anahtar rotasyonu: yeni anahtarı SSHBY_MASTER_KEY'e yazıp sürümü
# artırın, eskisini burada bırakın ki eski kayıtlar çözülebilsin.
# SSHBY_MASTER_KEY_VERSION=1
# SSHBY_MASTER_KEY_PREVIOUS=1:<eski-base64-anahtar>

# "Kayıt tutulamıyorsa bağlanma" politikası: true iken denetim
# Elasticsearch'e yazılamıyorsa yeni SSH oturumu açılmaz.
# AUDIT_STRICT_MODE=false

# Gönderilmiş denetim satırlarının yerel saklama süresi (ms, varsayılan 30 gün).
# Kısaltmayın: komut geçmişi ve gösterge panelindeki etkinlikler bu tablodan
# okuyor, ES açık olmayan kurulumlarda başka kaynak yok.
# AUDIT_RETAIN_SHIPPED_MS=2592000000

# Bir kullanıcının aynı anda açabileceği azami SSH oturumu.
# SSH_MAX_SESSIONS_PER_USER=20
# SFTP_MAX_UPLOAD_BYTES=2147483648

# LOG_LEVEL=info

# Bellek sınırları.
# POSTGRES_MEMORY_LIMIT=1g
# API_MEMORY_LIMIT=1g
# WEB_MEMORY_LIMIT=256m

# İmaj etiketi (aynı makinede birden çok sürüm tutmak için).
# SSHBY_TAG=latest

# =============================================================== ELASTICSEARCH
#
# Burada ES ayarı YOK — bilinçli.
#
# Denetim akışının hedefi (düğüm adresleri, kimlik doğrulama, CA sertifikası,
# indeks öneki, saklama süresi) uygulamanın içinden yapılandırılır:
#
#   Yönetim → Denetim akışı
#
# Ayarlar veritabanında `app_settings` tablosunda yaşıyor; parola ve API
# anahtarı yanıtlarda maskeleniyor. Bu yüzden ES adresini değiştirmek için
# konteyner yeniden başlatmak gerekmiyor ve gizli veri ortam değişkeninde
# durmuyor.
