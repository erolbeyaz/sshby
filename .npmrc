# Düz (npm benzeri) node_modules düzeni. pnpm'in varsayılan sembolik bağ ağacı
# Docker aşamaları arasında kopyalanınca kırılıyor; "hoisted" ile node_modules
# tek parça hâlinde taşınabiliyor.
node-linker=hoisted

# Native paketlerin derleme betikleri çalışabilsin (@node-rs/argon2 prebuild indirir).
enable-pre-post-scripts=true
